# Sprint 1 — authentification à un seul compte admin (placeholder,
# cf. README.md). À remplacer par une vraie gestion multi-utilisateurs
# quand le stockage définitif (PostgreSQL/Supabase) sera spécifié.

ADMIN_EMAIL=admin@matiereetnuance.fr
ADMIN_PASSWORD=change-me
# Chaîne aléatoire longue (ex: openssl rand -base64 32) — signe les cookies de session.
SESSION_SECRET=change-me-too

# Sprint 6 — persistance Google Sheets via Apps Script (voir
# apps-script/README-APPS-SCRIPT.md pour la procédure complète).
# URL de déploiement du Web App Apps Script (se termine par /exec).
APPS_SCRIPT_URL=https://script.google.com/macros/s/REMPLACER/exec
# Doit être IDENTIQUE à la propriété de script API_TOKEN côté Apps Script.
APPS_SCRIPT_API_TOKEN=change-me-too
