# Données générées à l'exécution (cache avis Google, anti-spam, connexion admin)
public/api/data/*.json

# Sauvegardes automatiques du contenu (admin) et mot de passe admin modifié
# depuis l'interface (ne doit jamais être commité en clair/haché)
public/api/data/content/backups/
public/api/data/content/admin-secrets.json

# Photos envoyées depuis l'administration (contenu du client, pas du code)
public/assets/img/uploads/*
!public/assets/img/uploads/.gitkeep
!public/assets/img/uploads/.htaccess
!public/assets/img/uploads/realisations
public/assets/img/uploads/realisations/*

# Fichiers système
.DS_Store
Thumbs.db

# Éditeurs
.vscode/
.idea/
