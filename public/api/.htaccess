# Empêche tout accès HTTP direct aux fichiers de configuration,
# bibliothèques internes et données (le formulaire/API y accèdent
# uniquement via include() côté serveur, jamais via une requête HTTP).

<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib/ - [F,L]
  RewriteRule ^data/ - [F,L]
  RewriteRule ^cron/ - [F,L]
</IfModule>

Options -Indexes
